{
  "version": 2,
  "builds": [
    {
      "src": "Project-Face-attandence-system-version-1.0/Project101/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{.venv/**,venv/**,*.zip}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "Project-Face-attandence-system-version-1.0/Project101/wsgi.py"
    }
  ]
}
